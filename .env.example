# Server
PORT=5000
NODE_ENV=development

# Required for signed customer login sessions.
# Generate a long random value (32+ characters) and never commit the real secret.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Required for all administrative API routes.
# Generate a different long random value (32+ characters) and never commit the real token.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
